# ============================================================
# MIR Search Engine - Root .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python virtual environments
.venv/
venv/
env/
backend/.venv/
backend/venv/

# Environment / secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Uploaded runtime documents
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
node_modules/
dist/
dist-ssr/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE / editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Local project diagnostics generated for ChatGPT/review
project-info/

# OS / temporary files
Thumbs.db
Desktop.ini
*.tmp
*.temp
